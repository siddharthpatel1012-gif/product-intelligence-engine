# Anthropic API key — used for extraction, structuring, VLM, and confidence reasoning
ANTHROPIC_API_KEY=sk-ant-...

# Pick ONE web search provider and set its key. The code defaults to Serper.
# Serper (https://serper.dev) - free tier, Google results
SERPER_API_KEY=

# Tavily (https://tavily.com) - free tier, built for LLM agents
TAVILY_API_KEY=

# Which provider to use: "serper" or "tavily"
SEARCH_PROVIDER=serper

# Model to use for all Claude calls
CLAUDE_MODEL=claude-sonnet-4-6
